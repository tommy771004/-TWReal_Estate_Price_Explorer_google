# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Public canonical origin used by SEO metadata and structured data.
VITE_SITE_URL="https://tw-real-estate-price-explorer-googl.vercel.app"

# Optional token copied from Google Search Console's HTML tag verification method.
VITE_GOOGLE_SITE_VERIFICATION=""

# Optional build-time override. Defaults to SOURCE_DATE_EPOCH or the UTC build date.
SEO_LAST_MODIFIED=""

# Neon PostgreSQL connection string (e.g., postgres://[user]:[password]@[host]/[dbname]?sslmode=require)
DATABASE_URL=

# ---------------------------------------------------------------------------
# 聯盟行銷 / 導購連結（選填）
# 申請通路王 iChannels 或聯盟網 Affiliates.One 後，取得各廣告主的「專屬追蹤連結」，
# 貼到下方對應變數即可。未填者不會顯示，毋須改動程式碼。
# 家具
VITE_AFF_NITORI=""
VITE_AFF_TRPLUS=""
VITE_AFF_HOLA=""
# 家電 / 3C
VITE_AFF_MOMO=""
VITE_AFF_PCHOME=""
VITE_AFF_TK3C=""
# 居家 / 裝潢
VITE_AFF_BUY321=""
VITE_AFF_PCONE=""
# 房貸 / 金融（VITE_AFF_LOAN 同時供房貸試算 CTA 的按鈕使用）
VITE_AFF_LOAN=""
VITE_AFF_CREDITCARD=""

