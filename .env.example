# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Public canonical origin used by SEO metadata and structured data.
VITE_SITE_URL="https://tw-real-estate-price-explorer-googl.vercel.app"

# Optional token copied from Google Search Console's HTML tag verification method.
VITE_GOOGLE_SITE_VERIFICATION=""

# Optional build-time override. Defaults to SOURCE_DATE_EPOCH or the UTC build date.
SEO_LAST_MODIFIED=""

# Neon PostgreSQL connection string (e.g., postgres://[user]:[password]@[host]/[dbname]?sslmode=require)
DATABASE_URL=

# Cross-project telemetry (server-only; do not use VITE_ for these values)
# TELEMETRY_INGEST_URL="https://<admin-console-domain>/api/telemetry/ingest"
# TELEMETRY_PROJECT_KEY="estate"
# TELEMETRY_INGEST_KEY="<same secret as the admin console TELEMETRY_INGEST_KEYS.estate>"

# ---------------------------------------------------------------------------
# 聯盟／合作推廣資料（見 docs/affiliate-integration-spec.md，server-only，切勿加 VITE_ 前綴）
# SUP_DATABASE_URL 指向獨立的聯盟資料庫（與 DATABASE_URL 分開）；schema 見 db/affiliates.sql。
# 未設定 SUP_DATABASE_URL 時，/api/affiliates 回傳空清單，前端不顯示推廣區塊。
SUP_DATABASE_URL=

# 本專案於 affiliates 資料表中的 project_name 分區鍵；未設定時預設為 "estate"。
AFFILIATE_PROJECT_NAME="estate"

