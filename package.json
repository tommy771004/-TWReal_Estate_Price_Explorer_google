{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "electron:dev": "NODE_ENV=development electron -r tsx/register electron-main.ts",
    "prebuild": "npm run seo:sitemap",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "seo:sitemap": "tsx scripts/generate-sitemap.ts",
    "seo:check": "node scripts/check-seo.mjs",
    "test:seo-date": "node --test scripts/seo-build-date.test.mjs",
    "test:seo-routes": "node --test scripts/seo-routes.test.mjs",
    "test:seo-sitemap": "node --import tsx --test scripts/seo-sitemap.test.mjs",
    "test:seo-content": "node --test scripts/seo-content-pages.test.mjs",
    "test:seo-docs": "node --test scripts/seo-docs.test.mjs",
    "test:seo-image": "node --test scripts/seo-social-image.test.mjs",
    "test:seo-performance": "node --test scripts/seo-performance.test.mjs",
    "test:seo-deployment": "node --test scripts/seo-deployment.test.mjs",
    "seo:verify-live": "node scripts/verify-seo-deployment.mjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@google/genai": "^1.29.0",
    "@neondatabase/serverless": "^1.1.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/papaparse": "^5.5.2",
    "@vis.gl/react-google-maps": "^1.8.3",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.15.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "iconv-lite": "^0.7.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "papaparse": "^5.5.3",
    "puppeteer": "^24.40.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "recharts": "^3.8.1",
    "shadcn": "^4.2.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.2.0",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "electron": "^41.2.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
